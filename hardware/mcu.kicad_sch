	(text "ESP32-S3-WROOM-1-N16R2 (16 MB flash, 2 MB PSRAM, PCB antenna)  -  reset and boot buttons, supply decoupling, debug UART, native USB and the GNSS link"
		(exclude_from_sim no)
		(at 25.4 31.75 0)
