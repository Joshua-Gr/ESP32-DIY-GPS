	(text "R2 10k pull-up: normal boot from flash.\nTo flash over UART: hold BOOT (SW2),\npress and release RESET (SW1), release BOOT.\nNative USB flashing does not need the buttons."
		(exclude_from_sim no)
		(at 27.94 172.72 0)
