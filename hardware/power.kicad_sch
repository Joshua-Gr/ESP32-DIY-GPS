		(uuid "095674b7-df25-4723-8172-96692f30de46")
	)
	(text "Compensation (type II)"
		(exclude_from_sim no)
		(at 236.22 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0c80f63f-7ef3-4352-a1c7-e32855526b0b")
	)
	(text "12 V vehicle input  ->  reverse-polarity & surge protection  ->  3.3 V / 1.5 A buck regulator  ->  +3V3 rail for the ESP32-S3 and the NEO-M9N"
		(exclude_from_sim no)
		(at 25.4 31.75 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "478119e0-1cd7-44d0-81ce-b823b7823cce")
	)
	(text "2   3.3 V BUCK REGULATOR   TPS54360  (6-60 V in, 3.3 V / 1.5 A out, 400 kHz)"
		(exclude_from_sim no)
		(at 162.56 44.45 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "5e40934e-eeb8-4be6-9948-1a68fb8c9c95")
	)
	(text "1   INPUT PROTECTION"
		(exclude_from_sim no)
		(at 25.4 44.45 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a807492b-7f88-4cc5-ad45-1ab95d8c6ff6")
	)
	(text "J1   12 V input, Molex Micro-Fit 3.0 (pin 1 = +12 V)\nD1   reverse-polarity protection: series Schottky, ~0.5 V drop\nD2   33 V TVS: clamps load-dump and transients to <= 53 V\nC1   100 uF bulk: damps the input cable inductance\nC2   3.3 uF / 100 V ceramic: high-frequency decoupling"
		(exclude_from_sim no)
		(at 27.94 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bb0fce83-e4f4-4937-80d4-e407dae482cd")
	)
	(text "+3V3 to ESP32-S3 (U2)\nand NEO-M9N (U3)"
		(exclude_from_sim no)
		(at 341.63 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bc8187e0-3a99-42c4-9269-d1e472436f15")
	)
	(text "POWER SUPPLY"
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fe870541-2434-426c-bd0a-17753bb63292")
	)
	(text "Vout = 0.8 V x (1 + R11/R12)"
		(exclude_from_sim no)
		(at 306.07 100.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "feb8de1c-a11b-41c9-aac4-01bf5c026d92")
	)
	(text_box "PCB LAYOUT NOTES\n- Hot loop C8 -> U1 VIN/GND -> D4: keep it as small as possible;\n  C8 sits directly at U1 pins 2 and 7.\n- Keep the SW copper (U1 pin 8, D4, L2, C11) small; route nothing under it on In1.\n- Keep R11/R12 and R13/C12/C13 on the side of U1 away from L2 and SW;\n  keep the FB trace short.\n- PowerPAD (pin 9) to the top GND pour; GND vias next to the pad, never in it\n  (tented vias, no via-in-pad)."
		(exclude_from_sim no)
		(at 200.66 137.16 0)
		(size 175.26 25.4)
		(margins 1.905 1.905 1.905 1.905)
		(stroke
			(width 0.1524)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7a2def45-1a9d-46f8-a4ba-2a8b4ab03678")
	)
	(text_box "DESIGN NOTES  (TPS54360 datasheet design procedure)\n- Switching frequency ~400 kHz, set by R10 = 243k on RT/CLK.\n- Vout = 0.8 V x (1 + 31.6k / 10k) = 3.33 V.\n- L2 22 uH: ripple ~0.19 A at 6.5 V in; peak 1.64 A, below Isat 2.2 A.\n- Type II compensation: R13 + C12 set the zero, C13 the pole; crossover ~22 kHz\n  with ~30 uF effective output capacitance (C9 + C10 after DC-bias derating).\n- Minimum on-time at 60 V in: 157 ns, above the 135 ns limit.\n- D4: 3 A / 60 V Schottky catch diode.  C11: 100 nF bootstrap capacitor."
		(exclude_from_sim no)
		(at 22.86 137.16 0)
		(size 170.18 25.4)
		(margins 1.905 1.905 1.905 1.905)
		(stroke
			(width 0.1524)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8d0406c2-34d4-4ec3-8445-a39a337494cc")
	)
