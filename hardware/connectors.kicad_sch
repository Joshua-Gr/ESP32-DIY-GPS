		)
		(fill
			(type none)
		)
		(uuid "08ac277a-e43e-422e-b045-20b261a0b19a")
	)
	(text "2   DEBUG UART  (J4)"
		(exclude_from_sim no)
		(at 160.02 44.45 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e7cb43b6-24fc-47c7-b330-6addd4c7bc80")
	)
	(text "J4 pinout:  1 = GND,  2 = TX (ESP32 out),  3 = RX (ESP32 in)\n3.3 V logic: use a 3.3 V USB-UART adapter\n(adapter RX to pin 2, adapter TX to pin 3). No power pin."
		(exclude_from_sim no)
		(at 160.02 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "03973456-292f-42eb-9e64-ad2b1aa7accf")
	)
