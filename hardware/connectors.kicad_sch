	)
	(text "VBUS is not connected: the board is powered from 12 V (J1),\nUSB carries data only.\nR8 / R9 5.1k pull-downs on CC1 / CC2 identify the board as a\nUSB device, so a USB-C host enables the port.\nBoth D+ and both D- pins are joined so the plug is reversible.\nShield tied to GND."
		(exclude_from_sim no)
		(at 27.94 136 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea3a830f-1d61-4a60-8e0c-a012b77c5f12")
	)
	(rectangle
		(start 157.48 38.1)
		(end 264.16 160.02)
