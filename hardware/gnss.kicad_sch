	)
	(text "VCC + V_BCKP from +3V3; C6 1 uF at the VCC pin.\nVDD_USB to GND: USB unused."
		(exclude_from_sim no)
		(at 142.24 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "76b7bcfe-cc28-41c4-b076-84c07dc86e52")
	)
	(text "D_SEL open = UART + I2C host interface.\nI2C, USB and EXTINT unused."
		(exclude_from_sim no)
		(at 154.94 149.86 0)
		(effects
