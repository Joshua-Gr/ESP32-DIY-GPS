	(text "3   ANTENNA FEED"
		(exclude_from_sim no)
		(at 233.68 44.45 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1c20b4df-542e-4326-823c-60c447f46bf5")
	)
	(text "Active antenna: VCC_RF (3.3 V) biases the antenna\nthrough R7 (current limit) and L1 (RF choke).\nC7 decouples VCC_RF. D3: ESD protection at J2.\n\nGNSS_RF: 50 ohm grounded coplanar line\n(0.32 mm / 0.2 mm gap), kept short, with a via fence."
		(exclude_from_sim no)
		(at 233.68 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5c974fcf-93b4-45b9-9b6b-eb37579e34c5")
	)
	(rectangle
		(start 22.86 38.1)
		(end 134.62 172.72)
		(stroke
