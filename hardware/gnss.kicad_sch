	(text "u-blox NEO-M9N (GPS, GLONASS, Galileo, BeiDou)  -  3.3 V supply, active-antenna bias feed with ESD protection, UART to the ESP32-S3, 1PPS and test points"
		(exclude_from_sim no)
		(at 25.4 31.75 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f4700f3e-0b91-4152-aac5-e6cc92f0dc39")
	)
