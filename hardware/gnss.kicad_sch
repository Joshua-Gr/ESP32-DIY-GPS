			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "f3738b01-901d-4ffa-aeeb-8f834ace8f1a")
	)
	(text "1   HOST UART AND TEST POINTS"
		(exclude_from_sim no)
		(at 25.4 44.45 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a7abf3e3-4e66-4605-84df-2492f7864cb8")
	)
	(text "GPS_TXD: receiver -> ESP32 (U1RXD, GPIO18)\nGPS_RXD: ESP32 (U1TXD, GPIO17, via R6) -> receiver\nTP3 / TP5: probe the UART"
		(exclude_from_sim no)
		(at 27.94 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "37d9fec4-9ba8-4f38-9c38-02143474f53b")
	)
	(text "TP1 SAFEBOOT: hold low at power-up for safe boot\n(firmware recovery).  TP2 RESET: pull low to reset.\nTP4: ground for the probe."
		(exclude_from_sim no)
		(at 27.94 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d67c762d-4475-4648-8948-024c1e226a64")
	)
